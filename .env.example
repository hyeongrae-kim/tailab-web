# Notion 통합(Integration) 시크릿. 서버 전용 — 절대 NEXT_PUBLIC_ 접두사 금지.
NOTION_TOKEN=

# 각 Notion 데이터베이스 ID (32자 hex)
NOTION_DB_NEWS=
NOTION_DB_PUBLICATIONS=
NOTION_DB_MEMBERS=
NOTION_DB_RESEARCH=
NOTION_DB_PROJECTS=
NOTION_DB_PROFESSOR=
NOTION_DB_CV=

# 웹훅 서명 검증용 시크릿 (Notion 구독 verification_token)
NOTION_WEBHOOK_SECRET=

# (setup 스크립트 전용) DB를 생성할 부모 Notion 페이지 ID. 런타임엔 불필요.
NOTION_PARENT_PAGE_ID=

# (선택) 수동 revalidate 보호용 토큰
REVALIDATE_SECRET=

# Vercel Blob 읽기/쓰기 토큰 (이미지 미러링용). Vercel에서 Blob 스토어 연결 시 자동 주입됨.
# 없으면 이미지는 노션 원본 URL을 그대로 씀(만료·대용량 문제 존재) → 로컬 테스트 시 채우면 미러링 동작.
BLOB_READ_WRITE_TOKEN=

# NOTE: NOTION_TOKEN 이 비어 있으면 lib/sample-data.ts 의 샘플 콘텐츠로 렌더된다.
NOTION_DB_SITE=
